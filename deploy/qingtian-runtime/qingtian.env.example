# Copy to qingtian.env and adjust on the QingTian parent ECS.

QINGTIAN_IMAGE=proof-observation-qingtian:dev
QINGTIAN_EIF=proof-observation-qingtian.signed.eif
QINGTIAN_CID=4
QINGTIAN_CPUS=2
QINGTIAN_MEM=1024

# Parent CID(s) used by the enclave to connect back to the parent egress proxy.
# The default keeps the existing Nitro-compatible behavior. If QingTian reports a
# different parent CID, set a comma-separated fallback list such as "3,2".
# This value is baked into the EIF and affects PCR0, so production releases
# should keep it fixed and record it in the release manifest.
QINGTIAN_PARENT_CIDS=3

# QingTian production egress mode.
#
# qproxy:
#   The EIF starts Huawei qproxy enclave inside the enclave and /attest connects
#   to qproxy's local TCP listener. QPROXY host must run on the parent VM with
#   the same config and connect to parent-local TCP forwarders.
#
# direct-vsock:
#   Legacy/smoke mode. /attest connects directly to parent CID / egress vsock
#   ports. This is useful for debugging with a simple bare vsock-to-TCP proxy,
#   but is not the Huawei qproxy production path.
QINGTIAN_EGRESS_MODE=qproxy
QINGTIAN_QPROXY_ENABLED=1

# Parent CID used by Huawei qproxy enclave. Keep this equal to the production
# parent CID, normally the first value in QINGTIAN_PARENT_CIDS.
QINGTIAN_QPROXY_PARENT_CID=3

# Local ports exposed inside the enclave by qproxy and matching vsock ports used
# by qproxy host. For multi-upstream production, keep one unique port per
# upstream host, e.g. dashscope.aliyuncs.com:8444 and api.openai.com:8445.
#
# Stock qproxy uses tcp_port as both the enclave-local listening port and the
# parent-side target port. To support multiple HTTPS upstreams that all use 443,
# configure qproxy to connect to parent-local ports and run a parent TCP mapper:
#
#   qproxy config entry: hostname="127.0.0.1", tcp_port=8444, vsock_port=8444
#   parent TCP mapper:   127.0.0.1:8444 -> dashscope.aliyuncs.com:443
QINGTIAN_QPROXY_EGRESS_PORTS=8444,8445

# The Huawei QingTian SDK checkout must contain enclave/qtsm/lib/Makefile.
QTSM_SDK_DIR=third_party/qingtian-sdk

# Optional apt mirror used inside Docker builds. Leave empty if the parent ECS
# can reach the default Debian mirrors. Use HTTP for Debian slim bootstrap
# because ca-certificates is not installed before the first apt-get update.
# Example:
# APT_MIRROR=http://repo.huaweicloud.com/debian
APT_MIRROR=

# Optional Cargo registry mirror used inside Docker builds. This is commonly
# needed when the parent ECS cannot resolve or reach index.crates.io. Example:
# CARGO_REGISTRY_MIRROR=sparse+https://rsproxy.cn/index/
CARGO_REGISTRY_MIRROR=

# Production should sign the EIF so PCR8 is non-zero and reproducible from the
# signing certificate. Use the official make-img path:
# qt enclave make-img --private-key ... --signing-certificate ...
QINGTIAN_PRIVATE_KEY=private-key.pem
QINGTIAN_SIGNING_CERTIFICATE=server.pem

# Extra args passed to qt enclave start, for example "--debug-mode" in smoke
# tests. Keep empty for production.
QINGTIAN_START_EXTRA_ARGS=
